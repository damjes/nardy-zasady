%!PS
%%LanguageLevel: 3

/kolory-pionow [
	<<
		/fill       [0.15 1.0 45]
		/stroke     [0.80 0.9 45]
		/fingerdish [0.40 1.0 45]
	>>
	<<
		/fill       [1.0 0.8 5]
		/stroke     [0.9 0.6 5]
		/fingerdish [1.0 0.7 5]
	>>
] def

/kolory-pol [
    [0.90 0.70 90]
    [0.95 0.95 40]
] def

/kolor-planszy [
	0.6 0.4 20
] def

/kolory-zawiasow <<
	/fill [0.80 0.80 0.80]
	/stroke [0.60 0.60 0.60]
>> def

/kolor-wnetrza [
	0 1 0
] def

/kolor-numeracji [
	0 1 0
] def

/wybierz-kolor {
	aload pop % rozpisz kolor
	360 div 3 1 roll % oblicz H z kąta i zrób SBkąt -> HSB
	sethsbcolor % i ustaw
} def

/wybierz-wariant-koloru {
	2 mod get wybierz-kolor
} def
