%!PS
%%LanguageLevel: 3

/prostokat {
	/y2 exch def
	/x2 exch def
	/y1 exch def
	/x1 exch def

	x1 y1 moveto
	x2 y1 lineto
	x2 y2 lineto
	x1 y2 lineto
	closepath
} def

/pole {
	/skala-y exch def
	/skala-x exch def
	/wariant exch def
	/pozycja exch def

	kolory-pol wariant wybierz-wariant-koloru

	pozycja licz-x skala-x mul
	0 licz-y skala-y mul
	moveto

	pozycja 1 add licz-x skala-x mul
	0 licz-y skala-y mul
	lineto

	pozycja 0.5 add licz-x skala-x mul
	wysokosc-pola licz-y skala-y mul
	lineto

	closepath
	fill
} def

/pion {
	newpath % bo się przykleja do ostatniego napisu
	1.5 dup setlinewidth
	fi-piona sub 2 div /r exch def

	/y exch def
	/x exch def
	/kolor exch def

	x y r 0 360 arc
	gsave
		kolor /fill get wybierz-kolor
		fill
	grestore
	
	kolor /stroke get wybierz-kolor
	stroke

	kolor /fingerdish get wybierz-kolor
	x y 13 0 360 arc
	fill
} def

/rzad-pionow {
	/kierunek exch def
	/y exch def
	/x exch def
	/kolor exch def
	/liczba-pionow exch def

	/delta-y
		fi-piona kierunek mul
	def

	liczba-pionow {
		kolor x y pion
		/y y delta-y add def
	} repeat
} def

/piony-na-polu {
	/pole exch def
	/liczba-pionow exch def
	/kolor exch def

	/kierunek 1
	pole 12 gt {
		neg
	} if def

	liczba-pionow
	kolor
	pole licz-xy-pola fi-piona 2 div kierunek mul add
	kierunek
	rzad-pionow
} def

/piony-symetrycznie {
	/pole exch def
	/liczba-pionow exch def

	kolory-pionow 0 get
	liczba-pionow
	pole
	piony-na-polu

	kolory-pionow 1 get
	liczba-pionow
	25 pole sub
	piony-na-polu
} def

/polozenie-poczatkowe {
	2 24 piony-symetrycznie
	5 13 piony-symetrycznie
	3 8 piony-symetrycznie
	5 6 piony-symetrycznie
} def

/plansza {
	[-1 1] {
		/skala-x exch def
		% rysuj połówkę (lewą lub prawą)

		kolor-planszy wybierz-kolor

		polowa-szparki skala-x mul
		granica-pudelka-y neg
		granica-pudelka-x skala-x mul
		granica-pudelka-y
		prostokat fill

		kolor-wnetrza wybierz-kolor

		0 licz-x skala-x mul
		baza-y neg
		6 licz-x skala-x mul
		baza-y
		prostokat fill

		bok-x-wewn skala-x mul
		bok-y-kostki neg
		bok-x-zewn skala-x mul
		bok-y-kostki
		prostokat fill

		[-1 1] {
			/skala-y exch def
			% rysuj ćwiartkę (górną lub dolną)

			kolor-wnetrza wybierz-kolor

			bok-x-wewn skala-x mul
			bok-y-piony skala-y mul
			bok-x-zewn skala-x mul
			baza-y skala-y mul
			prostokat fill

			/podstawa-koloru
				skala-x normalizuj
				skala-y normalizuj add cvi
			def

			0 1 5 {
				dup podstawa-koloru add
				skala-x skala-y pole
			} for
		} forall
	} forall
} def